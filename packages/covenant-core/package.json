{
  "name": "@covenant/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm check:loc && tsc -p tsconfig.build.json",
    "check:loc": "node ./scripts/check-loc.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:pbt": "vitest run --passWithNoTests test/pbt",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.17.14",
    "typescript": "^5.7.3",
    "vitest": "^2.1.9"
  }
}
